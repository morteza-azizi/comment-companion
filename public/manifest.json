{
  "manifest_version": 3,
  "name": "Comment Companion",
  "version": "0.1.0",
  "description": "Reusable comments across community platforms.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://www.vivino.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.vivino.com/*"],
      "js": ["src/content/content.ts"]
    }
  ],

  "action": {
    "default_title": "Comment Companion"
  }
}